<?php
require_once __DIR__ . '/../config/db.php';

// --- PARTE 1: Lógica de Registro (POST) ---
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $numero_grupo = $_POST['numero_grupo'];
    $nombre_grupo = $_POST['nombre_grupo'];
    $id_tareas = intval($_POST['id_tareas']);
    $id_operativo = intval($_POST['id_operativo']);
    $id_lugar = intval($_POST['id_lugar']);
    $fecha = $_POST['fecha'];
    $dni_promotoras = $_POST['dni_promotoras']; 

    $conn->begin_transaction();
    try {
        $stmt = $conn->prepare("INSERT INTO grupos (numero_grupo, nombre_grupo, id_tareas, id_operativo, id_lugar, fecha) VALUES (?, ?, ?, ?, ?, ?)");
        $stmt->bind_param("isiiis", $numero_grupo, $nombre_grupo, $id_tareas, $id_operativo, $id_lugar, $fecha);
        $stmt->execute();
        $id_nuevo_grupo = $conn->insert_id;

        $stmt_prom = $conn->prepare("INSERT INTO grupos_promotoras (id_grupos, dni_promotoras) VALUES (?, ?)");
        foreach ($dni_promotoras as $dni) {
            $stmt_prom->bind_param("ii", $id_nuevo_grupo, $dni);
            $stmt_prom->execute();
        }
        $conn->commit();
    } catch (Exception $e) {
        $conn->rollback();
        echo "Error al registrar: " . $e->getMessage();
    }
}

// --- PARTE 2: Consulta de Historial General (GET) ---
// Esta consulta se ejecuta siempre para mostrar la tabla debajo del formulario
$sql_historial = "SELECT 
                    g.fecha, 
                    g.numero_grupo, 
                    g.nombre_grupo, 
                    l.lugar, 
                    t.tareas, 
                    o.opearativos,
                    GROUP_CONCAT(p.nombre_completo SEPARATOR ', ') AS lista_promotoras
                  FROM grupos g
                  JOIN lugar l ON g.id_lugar = l.id_lugar
                  JOIN tareas t ON g.id_tareas = t.id_tareas
                  JOIN operaivos o ON g.id_operativo = o.id_operativos
                  JOIN grupos_promotoras gp ON g.id_grupos = gp.id_grupos
                  JOIN promotoras p ON gp.dni_promotoras = p.dni_promotoras
                  GROUP BY g.id_grupos, g.fecha, g.numero_grupo, g.nombre_grupo, l.lugar, t.tareas, o.opearativos
                  ORDER BY g.fecha DESC";

$res_historial = $conn->query($sql_historial);
?>